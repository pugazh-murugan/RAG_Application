# LLM: OpenAI (leave LLM_BASE_URL empty). For another OpenAI-compatible provider set its base URL.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5.4-mini

# Embeddings: "huggingface" (sentence-transformers model from Hugging Face, runs locally) or "openai"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-base
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Used only when EMBEDDING_PROVIDER=openai (falls back to LLM_API_KEY if empty)
OPENAI_API_KEY=

# Scraper
UZHAVAN_BASE_URL=https://www.tnagrisnet.tn.gov.in/people_app/dashboard/main/en
SCRAPE_MIN_PAGES=10
SCRAPE_MAX_PAGES=12

# Frontend
BACKEND_URL=http://localhost:8000
